@startuml state_hunter
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
title Диаграмма состояний: цель охотника

[*] --> Разведка
state "Разведка\n(идёт в ближайшую OK)" as Разведка
state "Охота\n(идёт на линию с W!, стреляет)" as Охота
state "За золотом" as Золото
state "К выходу с золотом" as Выход
state "Риск\n(выстрел наугад или\nкомната с недоказанной ямой)" as Риск
state "К выходу без золота" as Сдался

Разведка --> Разведка : новая OK-комната
Разведка --> Охота : вывод W!
Разведка --> Риск : OK-комнат нет,\nриск разрешён
Разведка --> Сдался : OK-комнат нет,\nриск запрещён
Охота --> Золото : крик и G!
Охота --> Разведка : крик, золото не найдено
Разведка --> Золото : Вампус убит и G!
Риск --> Разведка : выжил
Риск --> Сдался : промах, стрелы нет
Риск --> [*] : упал в яму
Золото --> Выход : золото взято
Выход --> [*] : выбрался — победа
Сдался --> [*] : выбрался без золота
@enduml

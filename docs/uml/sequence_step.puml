@startuml sequence_step
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
title Диаграмма последовательности: кнопка «Шаг»

actor "Пользователь" as user
participant "WumpusApp" as app
participant "GameController" as ctl
participant "Hunter" as hunter
participant "KnowledgeBase" as kb
participant "Dpll" as dpll
participant "World" as world

user -> app : нажать «Шаг»
app -> ctl : stepOnce()
ctl -> hunter : next(percept)
hunter --> ctl : следующее действие плана\n(поворот, шаг, выстрел...)
ctl -> world : execute(действие)
world --> ctl : измерение
ctl -> hunter : perceive(измерение)
opt комната новая
  hunter -> kb : tell(измерение как предложения)
end
ctl -> hunter : think()
opt план выполнен — новый шаг вывода
  hunter -> kb : statuses(все факты)
  loop для фактов без готового ответа
    kb -> dpll : solve(база + факт)
    dpll --> kb : расстановка или «невыполнимо»
  end
  kb --> hunter : нет / может быть / да
  hunter -> hunter : выбрать цель, построить план,\nзаписать шаг в журнал
end
ctl --> app
app -> app : перерисовать карты,\nсостояние и журнал
@enduml

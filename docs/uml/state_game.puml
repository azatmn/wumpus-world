@startuml state_game
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
title Диаграмма состояний: игра в окне

[*] --> Пауза : запуск программы\n(пример из задания,\nохотник уже подумал на старте)
Пауза --> Идёт : «Старт»
Идёт --> Пауза : «Пауза» / «Шаг»
Пауза --> Пауза : «Шаг» / одно действие
Идёт --> Идёт : кадр / действия по скорости
state "Игра окончена" as Over {
  state "Победа" as Won
  state "Гибель" as Dead
  state "Выбрался без золота" as Left
}
Идёт --> Won : выбрался с золотом
Идёт --> Dead : яма или живой Вампус
Идёт --> Left : выбрался без золота
Пауза --> Over : «Шаг» закончил игру
Over --> Пауза : «Сначала» / «Новая пещера» /\n«Пример из задания» / смена риска
Идёт --> Пауза : «Сначала» / «Новая пещера» /\n«Пример из задания» / смена риска
@enduml

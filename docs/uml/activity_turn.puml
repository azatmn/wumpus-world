@startuml activity_turn
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
title Диаграмма деятельности: шаг вывода охотника

start
:Получить измерение\n(Stench, Breeze, Glitter, Bump, Scream);
if (Комната новая?) then (да)
  :TELL: «здесь нет ямы и живого Вампуса»,\nправила ветерка, запаха, блеска;
endif
if (Был выстрел?) then (да)
  :TELL: Вампус на линии стрелы\n(крик) или его там нет (тишина);
endif
if (План пуст?) then (да)
  :ASK: для каждой комнаты\nяма? Вампус? золото? → нет / может быть / да;
  :Записать в журнал новые выводы;
  if (Золото у охотника?) then (да)
    :Идти к выходу и выбраться;
  elseif (Вампус убит и золото найдено?) then (да)
    :Идти за золотом и взять его;
  elseif (Стрелы нет, Вампус жив?) then (да)
    :Идти к выходу без золота;
  elseif (Вампус найден (W!)?) then (да)
    :Встать на одну линию с ним\nи выстрелить;
  elseif (Есть непосещённая OK-комната?) then (да)
    :Идти в ближайшую OK-комнату;
  elseif (Риск разрешён?) then (да)
    if (Вампус может быть на линии выстрела?) then (да)
      :Выстрелить наугад;
    else (нет)
      :Идти в комнату,\nгде яма не доказана;
    endif
  else (нет)
    :Идти к выходу без золота;
  endif
endif
:Выполнить следующее действие плана;
stop
@enduml
